generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  stellarAddress    String         @unique
  role              Role           @default(FREELANCER)
  username          String?
  displayName       String?
  avatarUrl         String?
  bio               String?
  email             String?
  reputationScore   Int            @default(0)
  totalProjects     Int            @default(0)
  completedProjects Int            @default(0)
  isOnboarded       Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  projectsAsClient     Project[]     @relation("ClientProjects")
  projectsAsFreelancer Project[]     @relation("FreelancerProjects")
  disputesRaised       Dispute[]
  integrations         Integration[]
  notifications        Notification[]
  reviewsGiven         Review[]      @relation("ReviewFrom")
  reviewsReceived      Review[]      @relation("ReviewTo")
  transactions         Transaction[]

  @@index([stellarAddress])
}

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

model Project {
  id               String        @id @default(uuid())
  title            String
  description      String?
  status           ProjectStatus @default(PENDING)
  escrowAmount     String        @default("0")
  tokenSymbol      String        @default("USDC")
  stellarEscrowId  String?
  escrowContractId String?
  clientId         String
  freelancerId     String?
  deadline         DateTime?
  githubRepo       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client      User       @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  freelancer  User?      @relation("FreelancerProjects", fields: [freelancerId], references: [id], onDelete: SetNull)
  milestones  Milestone[]
  disputes    Dispute[]
  reviews     Review[]
  escrow      Escrow?

  @@index([clientId])
  @@index([freelancerId])
}

enum ProjectStatus {
  PENDING
  FUNDED
  IN_PROGRESS
  COMPLETED
  DISPUTED
  CANCELLED
}

model Milestone {
  id            String           @id @default(uuid())
  projectId     String
  title         String
  description   String?
  amount        String
  status        MilestoneStatus  @default(PENDING)
  dueDate       DateTime?
  submissionUri String?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

model Escrow {
  id                 String      @id @default(uuid())
  projectId          String      @unique
  stellarEscrowId    String      @unique
  contractId         String
  clientAddress      String
  freelancerAddress  String
  tokenAddress       String
  amount             String
  releasedAmount     String      @default("0")
  state              EscrowState @default(FUNDED)
  milestoneCount     Int         @default(1)
  completedMilestones Int        @default(0)
  expiresAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum EscrowState {
  FUNDED
  ACTIVE
  COMPLETED
  DISPUTED
  REFUNDED
}

model Dispute {
  id                String       @id @default(uuid())
  projectId         String
  raisedById        String
  reason            String
  description       String?
  state             DisputeState @default(OPEN)
  verdict           Verdict?
  resolution        String?
  clientAmount      String?
  freelancerAmount  String?
  createdAt         DateTime     @default(now())
  resolvedAt        DateTime?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  raisedBy User    @relation(fields: [raisedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([raisedById])
}

enum DisputeState {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum Verdict {
  IN_FAVOR_OF_CLIENT
  IN_FAVOR_OF_FREELANCER
  SPLIT
  DISMISSED
}

model Review {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  projectId String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  from    User     @relation("ReviewFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to      User     @relation("ReviewTo", fields: [toId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([fromId])
  @@index([toId])
  @@index([projectId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Integration {
  id           String   @id @default(uuid())
  userId       String
  plugin       String
  status       String   @default("disconnected")
  scopes       String[]
  accessToken  String?
  refreshToken String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String
  type          String
  amount        String
  tokenSymbol   String   @default("USDC")
  stellarTxHash String?
  status        String   @default("pending")
  description   String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebhookEvent {
  id        String   @id @default(uuid())
  source    String
  event     String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
  projectId String?
  userId    String?

  @@index([source])
  @@index([processed])
  @@index([projectId])
  @@index([userId])
}
