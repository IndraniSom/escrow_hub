# Database (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Stellar Network
STELLAR_NETWORK="TESTNET"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"

# Corsair (Integration SDK)
CORSAIR_API_KEY="your-corsair-api-key"
CORSAIR_SIGNING_SECRET="your-corsair-signing-secret"
CORSAIR_KEK="your-corsair-key-encryption-key"

# App
APP_URL="http://localhost:4000"
PORT=4000
